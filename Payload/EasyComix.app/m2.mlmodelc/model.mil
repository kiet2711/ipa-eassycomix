            tensor<fp16, [2, 12, 197, 64]> cross_k_cast_fp16 = transpose(perm = cross_k_perm_0, x = _before_transpose_op_cross_k_cast_fp16)[name = string("transpose_0")];
            tensor<fp32, [2, 12, 197, 64]> cross_k = cast(dtype = cross_k_cast_fp16_to_fp32_dtype_0, x = cross_k_cast_fp16)[name = string("cast_0")];
            tensor<fp16, [2, 12, 197, 64]> cross_v_cast_fp16 = transpose(perm = cross_v_perm_0, x = _before_transpose_op_cross_v_cast_fp16)[name = string("transpose_1")];
            tensor<fp32, [2, 12, 197, 64]> cross_v = cast(dtype = cross_v_cast_fp16_to_fp32_dtype_0, x = cross_v_cast_fp16)[name = string("cast_1")];
        } -> (cross_k, cross_v);
